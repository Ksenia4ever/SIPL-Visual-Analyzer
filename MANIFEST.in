include README.md
include CHANGELOG.md
include LICENSE
include pyproject.toml

recursive-include src/sipl *.py
recursive-include src/sipl *.lark

recursive-include grammar *.md
recursive-include docs *.md
recursive-include examples *.sipl
recursive-include tests *.py
recursive-include tests/golden *.json

global-exclude __pycache__
global-exclude *.pyc
global-exclude *.pyo
